# Server
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Database
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/portfolio

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=portfolio_admin_token

# Admin bootstrap (used only by npm run seed:admin, then rotate the password)
ADMIN_NAME=Muhammad Shahroz Shahzad
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-immediately

# Email (SMTP) - notifications for new contact messages
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Portfolio Contact Form <no-reply@example.com>"
NOTIFY_EMAIL=shahrozshahzad17@gmail.com

# Analytics
IP_HASH_SALT=replace-with-a-random-salt
ANALYTICS_RETENTION_DAYS=180
